// ADR 0090 benchmark: 200 buffers of 16 MiB made ready for C to write into, by today's `resize(n, 0)`.
fn main() {
    var sum: usize = 0;
    for (i in 0u32..200) {
        var v = Vector<u8>.create();
        v.resize(16 * 1024 * 1024, 0)!;
        sum += v.capacity;
    }
    Console.writeLine(sum);
}
